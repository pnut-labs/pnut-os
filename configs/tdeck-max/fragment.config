#
# SPDX-License-Identifier: Apache-2.0
#
# pnut-os's options for the tdeck-max target, merged over the board's
# configuration (named in target.mk) with NuttX's tools/merge_config.py.
#

# libpnut's services and clients talk on local stream sockets, and learn
# who called from SO_PEERCRED (RFC 0005)

CONFIG_NET=y
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_SCM=y
CONFIG_NET_SOCKOPTS=y
CONFIG_PNUT_LIB=y

# nanopb, for the interfaces' messages (RFC 0023): nuttx-apps' package,
# built from the copy the top-level Makefile fetches and checks (its own
# version option names only the download it then skips)

CONFIG_NETUTILS_NANOPB=y

# uORB, for topics (RFC 0005): on NuttX's sensor framework, its user
# sensors standing for topics

CONFIG_SENSORS=y
CONFIG_USENSOR=y
CONFIG_UORB=y

# The system program, with Service states, Settings, Power and Time
# (RFC 0007, RFC 0025, RFC 0028).  The settings' files, and Time's state,
# go to the system partition, the littlefs the board mounts at /var/lib
# (RFC 0010), so they are kept across restarts.  The board's
# configuration has the partition; named here, so that the build stops if
# it goes and settings would be lost at every restart.

CONFIG_PNUT_SYSTEM=y
CONFIG_PNUT_SETTINGS_DIR="/var/lib/settings"
CONFIG_PNUT_TIME_STATE="/var/lib/time"
CONFIG_ESP32S3_SPIFLASH=y
CONFIG_ESP32S3_SPIFLASH_LITTLEFS=y
CONFIG_ESP32S3_SPIFLASH_MOUNTPT="/var/lib"

# libsodium, for Settings' secrets (RFC 0031): ISC licensed.  nuttx-apps'
# package fetches its release and checks its SHA-256.

CONFIG_ALLOW_ICS_COMPONENTS=y
CONFIG_LIBSODIUM=y

# Its nonces and its key come from /dev/urandom: the chip's generator
# (DEV_URANDOM_ARCH), fed by the ADC's noise source from start-up on

CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y

# The shell's commands (RFC 0012): settings, which lists, reads, changes
# and resets settings from the console or adb's shell; telephony, the
# modem's state, the SIM's PIN, and an AT command passed through.

CONFIG_PNUT_COMMANDS=y

# The telephony program (RFC 0030): the A7682E, its UART multiplexed, its
# state and the network's time announced
CONFIG_PNUT_TELEPHONY=y

# Mobile data (RFC 0030, step 4): NuttX's pppd on the multiplexer's data
# channel, through a pseudo-terminal, its link a TUN device.  PPP's packets
# stop at 1440 bytes, since the operators' path drops larger ones (the
# previous system's finding); pppd's buffer takes 1600.

CONFIG_NETUTILS_PPPD=y
CONFIG_NET_TUN=y
CONFIG_NET_TUN_PKTSIZE=1440

# The network program: Wi-Fi (RFC 0031), its driver brought up by the
# board's /dev/wifi_en when Wi-Fi is first turned on; and Network
# (RFC 0015), which sets the default route through the link in use (a
# local network's addresses stay on it: the longest match wins), gives
# name lookups that link's name server, one (NETDB_DNSSERVER_NAMESERVERS),
# and none at start (not NuttX's 10.0.0.1), and keeps adb to the local
# links with NuttX's packet filter

CONFIG_PNUT_NETWORK=y
CONFIG_PNUT_WIFI_ENABLE="/dev/wifi_en"
CONFIG_NET_ROUTE=y
CONFIG_ROUTE_LONGEST_MATCH=y
CONFIG_NETDB_DNSSERVER_NOADDR=y
# CONFIG_NETDB_DNSSERVER_IPv4 is not set
CONFIG_NET_IPFILTER=y
CONFIG_NETDEV_IFINDEX=y

# The data program (RFC 0007): Messages (RFC 0029), its store in the
# system partition, up to 1 MB of its 2 MB

CONFIG_PNUT_DATA=y
CONFIG_PNUT_MESSAGES_DIR="/var/lib/messages"

# File names up to 64 characters: a settings file is named after its
# owner, an app's id among them (<owner>.pb.new).  littlefs keeps the
# limit in the volume as it formats it, and firmware with a smaller one
# cannot mount the volume, which the board then formats again: named
# here, so that the build stops if the board's goes back.

CONFIG_NAME_MAX=64

# The RTC keeps the time across a reset (RFC 0028); without it the clock
# would start again at Time's last saved time after every reset.  Named
# here, so that the build stops if the board's goes.

CONFIG_RTC=y
CONFIG_RTC_DRIVER=y

# Power powers the device off at a low battery: it reads the battery's
# gauge and charger, and powers off through the board.  The board's
# configuration has them all; named here, so that the build stops if one
# goes.

CONFIG_BATTERY_GAUGE=y
CONFIG_BATTERY_CHARGER=y
CONFIG_BQ27220=y
CONFIG_SY6970=y
CONFIG_BOARDCTL_POWEROFF=y

# Power hands the kernel the sleep clock's rate (RFC 0028), and the kernel
# corrects each light sleep by it.  The board's configuration has the
# option; named here, so that the build stops if it goes.

CONFIG_BOARDCTL_SLEEP_RATE=y

# The ESP32-S3 has no Ethernet for the start-up to bring up: its network
# devices register themselves, as in Espressif's configs; the board's
# configuration has it too, since it has Wi-Fi

CONFIG_NETDEV_LATEINIT=y

# The PSRAM is the user heap, which needs the low priority work queue; the
# board's configuration has it only because Bluetooth selects it.  Named
# here, so that the build stops rather than leave the PSRAM out of the heaps

CONFIG_SCHED_LPWORK=y

# NxInit starts pnut-os's programs from etc/init.d/pnut.rc, which imports
# the board's init.rc; they tell it on its control socket when they are
# ready (RFC 0006).  The system program, asked to stop, writes the
# settings not written yet; the telephony program powers the modem down
# in order, AT+CPOF, then up to 6 s or so before the rail goes (RFC 0030):
# they have 10 s before NxInit kills them.

CONFIG_SYSTEM_NXINIT_RC_FILE_PATH="/etc/init.d/pnut.rc"
CONFIG_NET_LOCAL_STREAM=y
CONFIG_SYSTEM_NXINIT_CONTROL=y
CONFIG_SYSTEM_NXINIT_SVC=y
CONFIG_SYSTEM_NXINIT_SERVICE_GENTLE_KILL_TIMEOUT=10000

# The system program keeps one connection to NxInit open, to watch the
# services; programs saying they are ready, and the system program asking
# who a task is, take one each for a moment

CONFIG_SYSTEM_NXINIT_CONTROL_CLIENTS=8

# Each line of the log carries its time since boot (the wall clock is
# early 1970 until Time sets it, and steps), its level and its program
# (RFC 0026); the service library adds the module's name.

CONFIG_SYSLOG_TIMESTAMP=y
CONFIG_SYSLOG_PRIORITY=y
CONFIG_SYSLOG_PROCESS_NAME=y

# Log (RFC 0026) follows the RAM log, which the board's configuration
# keeps across a reset, and keeps its warnings and errors, and crash
# reports, in /var/lib/log.  A fatal assertion (in an interrupt handler or
# a kernel thread) resets the device, its dump and backtrace left in the
# RAM log for Log to save at the next start; one in a program's task ends
# the task, NxInit starts the program again, and Log saves the dump as it
# comes.  The RAM log is named here, so that the build stops if it goes.

CONFIG_PNUT_LOG_DIR="/var/lib/log"
CONFIG_RAMLOG=y
CONFIG_RAMLOG_SYSLOG=y
CONFIG_BOARD_RESET_ON_ASSERT=1
CONFIG_SCHED_BACKTRACE=y

# The developer's shell (RFC 0012): lines of 256 characters and 64
# arguments, so that a long text (an SMS of several parts) can be typed
# into a command (the board's configuration had 128 and 16)
CONFIG_LINE_MAX=256
CONFIG_NSH_MAXARGUMENTS=64

# adb over the network (RFC 0012): adbd, from nuttx-apps (microADB pinned,
# hosts' keys checked), started at boot by the board's init.rc for now, and
# later from Developer options in the system UI, off after each restart, with
# the screen's prompt.  It is reached from the local links only, Wi-Fi here:
# Network drops its connections from mobile data.  A computer gets in only
# with its key in /var/lib/adb/keys: a new one's key waits in keys.new, and
# `adbkeys` lets it in.  The token adbd has a computer sign comes from
# /dev/urandom, the chip's random number generator (turned on above, for
# Settings' secrets).

CONFIG_LIBUV=y
CONFIG_PSEUDOTERM=y
CONFIG_SYSTEM_ADBD=y
CONFIG_ADBD_TCP_SERVER=y
CONFIG_ADBD_AUTHENTICATION=y
CONFIG_ADBD_AUTH_PUBKEY=y
CONFIG_ADBD_AUTH_KEYS="/var/lib/adb/keys"
CONFIG_ADBD_SHELL_SERVICE=y
CONFIG_ADBD_FILE_SERVICE=y
CONFIG_ADBD_LOGCAT_SERVICE=y
CONFIG_ADBD_STACKSIZE=8192
