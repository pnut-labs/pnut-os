#
# SPDX-License-Identifier: Apache-2.0
#
# pnut-os's options for the sim target, merged over the board's
# configuration (named in target.mk) with NuttX's tools/merge_config.py.
#

# libpnut's services and clients talk on local stream sockets, and learn
# who called from SO_PEERCRED (RFC 0005)

CONFIG_NET=y
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_SCM=y
CONFIG_NET_SOCKOPTS=y
CONFIG_PNUT_LIB=y

# nanopb, for the interfaces' messages (RFC 0023): nuttx-apps' package,
# built from the copy the top-level Makefile fetches and checks (its own
# version option names only the download it then skips)

CONFIG_NETUTILS_NANOPB=y

# uORB, for topics (RFC 0005): on NuttX's sensor framework, its user
# sensors standing for topics

CONFIG_SENSORS=y
CONFIG_USENSOR=y
CONFIG_UORB=y

# The system program, with Settings (RFC 0007, RFC 0025); its files go to
# /tmp, a tmpfs.  The simulator's bring-up mounts it, and its init.rc's
# second try at it says "mount failed: 20", which is harmless.

CONFIG_PNUT_SYSTEM=y
CONFIG_FS_TMPFS=y

# The unit tests as programs (make sim test).  nuttx-apps' cmocka needs
# NuttX's regex, which is MIT licensed.

CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
CONFIG_TESTING_CMOCKA=y
CONFIG_PNUT_TESTS=y
