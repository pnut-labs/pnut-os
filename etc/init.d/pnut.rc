/* NxInit's configuration for pnut-os (RFC 0006): the board's own first,
 * for its file systems and console, then pnut-os's programs.  NxInit
 * reads this file (CONFIG_SYSTEM_NXINIT_RC_FILE_PATH); the build lays
 * pnut-os's etc/ over the board's /etc (ETC_OVERLAY).
 */

#include <nuttx/config.h>

import /etc/init.d/init.rc

#ifdef CONFIG_PNUT_SYSTEM

/* The system program: Service states, Settings and Power (RFC 0007).  It
 * says when it is ready, through NxInit's control socket, and the others
 * wait for it:
 *
 *   on property:svc.system.state=ready
 *
 * Asked to stop, it writes the settings not written yet:
 * CONFIG_SYSTEM_NXINIT_SERVICE_GENTLE_KILL_TIMEOUT gives it the time.
 */

service system pnut_system
#ifdef CONFIG_SYSTEM_NXINIT_CONTROL
   notify
#endif
   gentle_kill

on init
   start system
#endif

#ifdef CONFIG_PNUT_TELEPHONY

/* The telephony program (RFC 0030), once the system program is ready: it
 * reads Board's description, its settings and Service states.  Asked to
 * stop, it powers the modem down in order first, which takes up to
 * CONFIG_PNUT_TELEPHONY_FINISH ms of the gentle kill time.
 */

service telephony pnut_telephony
#ifdef CONFIG_SYSTEM_NXINIT_CONTROL
   notify
#endif
   gentle_kill

on property:svc.system.state=ready
   start telephony
#endif

#ifdef CONFIG_PNUT_DATA
/* The data program (RFC 0007): Messages (RFC 0029), once the system
 * program is ready.  It reads its store's files on a worker, and says it
 * is ready once they are read.
 */

service data pnut_data
#ifdef CONFIG_SYSTEM_NXINIT_CONTROL
   notify
#endif
   gentle_kill

on property:svc.system.state=ready
   start data
#endif
