ifneq ($(CONFIG_PNUT_LIB),)
CONFIGURED_APPS += $(APPDIR)/external/lib

# Every program finds the library's headers as <pnut/...>

CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/external/lib/include
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/external/lib/include
endif
