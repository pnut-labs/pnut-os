include $(APPDIR)/Make.defs

# The unit tests of tests/unit, each file a program.  apps/external links
# to src/, so tests/ is beside it.

UNITDIR = $(realpath $(APPDIR)/external)/../tests/unit

# The test interface's code, generated by the top-level Makefile

GENDIR  = $(realpath $(APPDIR)/external)/../build/gen

PROGNAME  = pnut_test_conn pnut_test_gen pnut_test_ipc pnut_test_loop
PROGNAME += pnut_test_msg pnut_test_pool pnut_test_ready pnut_test_timer
PROGNAME += pnut_test_topic pnut_test_worker
PRIORITY  = SCHED_PRIORITY_DEFAULT
STACKSIZE = 16384
MODULE    = $(CONFIG_PNUT_TESTS)

MAINSRC   = $(UNITDIR)/test_conn.c $(UNITDIR)/test_gen.c
MAINSRC  += $(UNITDIR)/test_ipc.c $(UNITDIR)/test_loop.c
MAINSRC  += $(UNITDIR)/test_msg.c $(UNITDIR)/test_pool.c
MAINSRC  += $(UNITDIR)/test_ready.c $(UNITDIR)/test_timer.c
MAINSRC  += $(UNITDIR)/test_topic.c $(UNITDIR)/test_worker.c

# Settings' tests, with the system program's modules, which it compiles

ifneq ($(CONFIG_PNUT_SYSTEM),)
PROGNAME += pnut_test_settings
MAINSRC  += $(UNITDIR)/test_settings.c
CFLAGS   += ${INCDIR_PREFIX}$(APPDIR)/external/system
endif

CSRCS     = $(GENDIR)/pnut/test/echo.pb.c $(GENDIR)/pnut/test/echo.pnut.c
CSRCS    += $(GENDIR)/pnut/test/tick.pb.c $(GENDIR)/pnut/test/tick.topics.c

CFLAGS   += ${INCDIR_PREFIX}$(APPDIR)/external/lib
CFLAGS   += ${INCDIR_PREFIX}$(GENDIR)
CFLAGS   += ${INCDIR_PREFIX}$(APPDIR)/netutils/nanopb/nanopb

include $(APPDIR)/Application.mk
