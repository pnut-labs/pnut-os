config PNUT_TESTS
	bool "libpnut's unit tests, as programs"
	default n
	depends on PNUT_LIB && TESTING_CMOCKA && NETUTILS_NANOPB
	---help---
		The unit tests of tests/unit, built as NuttX programs, one per
		file: pnut_test_ipc, pnut_test_loop, and so on.  make <target> test
		runs them.
