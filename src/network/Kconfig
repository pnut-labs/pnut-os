config PNUT_NETWORK
	bool "The network program"
	default n
	depends on PNUT_LIB && NETUTILS_NANOPB && PNUT_SYSTEM && WIRELESS_WAPI && NETUTILS_DHCPC && NETUTILS_NETLIB
	---help---
		The network program: Wi-Fi (RFC 0031), which scans, joins a
		network and takes an address, and says the link's state on the
		wifi topic; and Network (RFC 0015), so far the link in use, on
		the network topic, and its name server.

if PNUT_NETWORK

config PNUT_NETWORK_STACKSIZE
	int "The program's stack, in bytes"
	default 8192

config PNUT_NETWORK_WORKER_STACKSIZE
	int "A worker's stack, in bytes"
	default 6144
	---help---
		The worker makes the radio's calls: the driver's association
		and DHCP run on its stack, as they ran on the system before
		this one's 6 KB thread.

config PNUT_NETWORK_LOCAL_LINKS
	string "The local links"
	default "wlan0"
	---help---
		The interfaces of the networks the device is in, as Wi-Fi's or
		Ethernet's, never mobile data's, separated by spaces: the local
		ports reach the device on them only (RFC 0012).

config PNUT_NETWORK_LOCAL_PORTS
	string "TCP ports served on the local links only"
	default ""
	---help---
		Besides adb's (ADBD_TCP_SERVER_PORT), always one, separated by
		spaces: connections to them from any other link, as mobile
		data, are dropped.  Through NuttX's packet filter
		(NET_IPFILTER): without it, Network says so in the log, and the
		ports are open on every link.

config PNUT_WIFI_IFNAME
	string "The Wi-Fi interface"
	default "wlan0"

config PNUT_WIFI_ENABLE
	string "The board's device that brings the Wi-Fi driver up"
	default ""
	---help---
		A GPIO device written 1 once, as the T-Deck Max's /dev/wifi_en,
		where the board leaves the driver down until asked; empty where
		the driver is up from the start.

endif
