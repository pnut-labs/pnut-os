config PNUT_MEDIA
	bool "The media program"
	default n
	depends on PNUT_LIB && NETUTILS_NANOPB && PNUT_SYSTEM
	---help---
		The media program (RFC 0007): so far Haptics (RFC 0033), which
		plays named effects and callers' own patterns on the vibration
		motor Board's description names.  Audio comes next.

if PNUT_MEDIA

config PNUT_MEDIA_STACKSIZE
	int "The program's stack, in bytes"
	default 6144

config PNUT_HAPTICS_DEVICE
	string "The motor's device, without Board"
	default ""
	---help---
		Empty: Haptics asks Board for the vibration motor
		(RFC 0024).  A path (a force-feedback device such as
		/dev/input_ff0) skips Board, for a target without its
		description.

config PNUT_AUDIO
	bool "Audio: the speaker (RFC 0032)"
	default y
	depends on AUDIO
	---help---
		The built-in sounds, mixed and played on the speaker
		Board's description names, by the uses' rules.

if PNUT_AUDIO

config PNUT_AUDIO_DEVICE
	string "The speaker's device, without Board"
	default ""
	---help---
		Empty: Audio asks Board for the speaker (RFC 0024).  A
		path (an audio device such as /dev/audio/pcm0) skips
		Board, for a target without its description.

config PNUT_AUDIO_SOUNDS
	string "The built-in sounds' directory"
	default "/usr/share/sounds"
	---help---
		Each <name>.wav in it is a built-in sound, read whole at
		start (RFC 0010; the system program mounts /usr).

config PNUT_AUDIO_HIGHPASS
	int "The speaker's high-pass, Hz (0: none)"
	default 300
	range 0 2000
	---help---
		What the speaker cannot play only shakes it, and is heard
		as distortion: taken out of everything played.

endif

endif
