"""protoc's plugin for pnut-os's interfaces (RFC 0023).

    protoc --plugin=protoc-gen-pnut=tools/protoc-gen-pnut \\
           --pnut_out=<dir> -I proto ... <file>.proto

For every service of a file it writes, beside nanopb's <file>.pb.h:

    <file>.pnut.h, <file>.pnut.c   typed client calls and server handlers,
                                   on libpnut's services and clients
    <file>.md                      the interface's reference

and for the file's topics, messages published on uORB:

    <file>.topics.h, <file>.topics.c   typed publishing and subscribing,
                                       on libpnut's topics

The services and messages carry pnut-os's options
(proto/pnut/options.proto): the interface's number, each method's number,
version and permission, and a topic's name and depth.
The module made from options.proto (options_pb2) must be on the Python
path.
"""

import re
import sys

try:
    from google.protobuf import descriptor_pb2
    from google.protobuf.compiler import plugin_pb2
except ImportError:
    sys.exit("protoc-gen-pnut: Python's protobuf module is missing "
             "(apt install python3-protobuf)")

from pnut import options_pb2

# Names the generated code takes for itself, which a method's would clash
# with

RESERVED = {"serve", "close", "connect", "disconnect", "state", "fail",
            "iface", "request_max", "reply_max"}

# C's keywords, which a method's name becomes in the handlers' struct;
# bool, true and false are C23's, and <stdbool.h>'s macros before

C_KEYWORDS = {"auto", "bool", "break", "case", "char", "const", "continue",
              "default", "do", "double", "else", "enum", "extern", "false",
              "float", "for", "goto", "if", "inline", "int", "long",
              "register", "restrict", "return", "short", "signed", "sizeof",
              "static", "struct", "switch", "true", "typedef", "union",
              "unsigned", "void", "volatile", "while"}


class GenError(Exception):
    """An interface the generator refuses."""


def underscore(word):
    """nanopb's C style (its --c-style): SayRequest -> say_request.

    The same rule as nanopb's NamingStyleC, so that the names written here
    are the ones nanopb wrote.
    """
    word = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1_\2", word)
    word = re.sub(r"([a-z\d])([A-Z])", r"\1_\2", word)
    return word.replace("-", "_").lower()


def c_name(type_name):
    """nanopb's C name of a message, without its _t: pnut_test_say_request."""
    return underscore(type_name.lstrip(".").replace(".", "_"))


class Msg:
    """A message's names in nanopb's C style."""

    def __init__(self, type_name):
        name = c_name(type_name)
        self.type = name + "_t"
        self.size = name.upper() + "_SIZE"
        self.fields = name.upper() + "_FIELDS"
        self.proto = type_name.lstrip(".")




class Method:
    def __init__(self, svc, desc):
        opts = desc.options
        if desc.client_streaming or desc.server_streaming:
            raise GenError(f"{svc.full}.{desc.name}: streams come later")
        if not opts.HasExtension(options_pb2.method):
            raise GenError(f"{svc.full}.{desc.name}: no (pnut.method)")

        self.name = desc.name
        self.snake = underscore(desc.name)
        self.number = opts.Extensions[options_pb2.method]
        self.version = opts.Extensions[options_pb2.version]
        self.permission = opts.Extensions[options_pb2.permission]
        self.req = Msg(desc.input_type)
        self.reply = Msg(desc.output_type)
        self.doc = ""

        if not 0 < self.number < 0x10000:
            raise GenError(f"{svc.full}.{desc.name}: method {self.number}")
        if not 0 < self.version < 0x100:
            raise GenError(f"{svc.full}.{desc.name}: version {self.version}")


class Service:
    def __init__(self, fdesc, desc):
        self.full = f"{fdesc.package}.{desc.name}" if fdesc.package \
            else desc.name
        if not desc.options.HasExtension(options_pb2.iface):
            raise GenError(f"{self.full}: no (pnut.iface)")

        self.iface = desc.options.Extensions[options_pb2.iface]
        if not 0 < self.iface < 0x10000:
            raise GenError(f"{self.full}: interface {self.iface}")

        self.name = desc.name
        self.prefix = c_name(self.full)
        self.upper = self.prefix.upper()
        self.doc = ""
        self.methods = [Method(self, m) for m in desc.method]

        if not self.methods:
            raise GenError(f"{self.full}: no methods")

        numbers = [m.number for m in self.methods]
        if len(set(numbers)) != len(numbers):
            raise GenError(f"{self.full}: a method number used twice")

        # A method's names must not clash with the generated code's own,
        # nor with another method's

        snakes = [m.snake for m in self.methods]
        if len(set(snakes)) != len(snakes):
            raise GenError(f"{self.full}: two methods with one C name")

        taken = set()
        for m in self.methods:
            if m.snake in RESERVED:
                raise GenError(f"{self.full}.{m.name}: the name {m.snake} "
                               "is the generated code's own")
            if m.snake in C_KEYWORDS:
                raise GenError(f"{self.full}.{m.name}: the name {m.snake} "
                               "is a C keyword")
            taken |= {m.snake + s for s in
                      ("_reply", "_handler", "_answer", "_done")}
        for m in self.methods:
            if m.snake in taken:
                raise GenError(f"{self.full}.{m.name}: clashes with the "
                               "names generated for another method")


class Topic:
    """A message published on a topic."""

    def __init__(self, fdesc, desc):
        self.msg = Msg(f".{fdesc.package}.{desc.name}" if fdesc.package
                       else f".{desc.name}")
        self.full = self.msg.proto
        self.name = desc.options.Extensions[options_pb2.topic]
        self.depth = desc.options.Extensions[options_pb2.depth]
        self.prefix = c_name(self.full)
        self.doc = ""

        if not re.fullmatch(r"[a-z][a-z0-9_]*", self.name):
            raise GenError(f"{self.full}: topic {self.name!r}: lowercase "
                           "letters, digits and underscores")
        # uORB registers /dev/uorb/<name><instance> in a path of NAME_MAX
        # (32) bytes (struct sensor_reginfo_s): a longer name is cut, and
        # the topic cannot be opened

        if len(self.name) > 20:
            raise GenError(f"{self.full}: topic {self.name}: longer than "
                           "20 characters")
        if not 0 < self.depth < 0x100:
            raise GenError(f"{self.full}: depth {self.depth}")


def nested_topics(mdesc, prefix=""):
    """The messages nested in a message that would be topics."""
    found = []
    for n in mdesc.nested_type:
        name = f"{prefix}{n.name}"
        if n.options.HasExtension(options_pb2.topic):
            found.append(name)
        found += nested_topics(n, name + ".")
    return found


def service_names(svc):
    """The C names a service's code takes."""
    p = svc.prefix
    names = {f"{p}_{s}" for s in ("serve", "close", "fail", "connect",
                                  "disconnect", "state", "state_t",
                                  "server_s", "client_s", "call_s",
                                  "handlers_s", "methods")}
    for m in svc.methods:
        names |= {f"{p}_{m.snake}{s}" for s in
                  ("", "_reply", "_handler", "_answer", "_done_t")}
    return names


def topic_names(t):
    """The C names a topic's code takes."""
    p = t.prefix
    return {f"{p}_{s}" for s in ("advertise", "publish", "subscribe",
                                 "unsubscribe", "deliver", "handler_t",
                                 "reader_s")} | {f"g_{p}_topic"}


def topics_header(path, topics, fdesc):
    guard = "__PNUT_GEN_" + re.sub(r"\W", "_", path).upper() + "_TOPICS_H"
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append(f"#ifndef {guard}")
    w.append(f"#define {guard}")
    w.append("")
    w.append("#ifdef __NuttX__")
    w.append("#  include <nuttx/config.h>")
    w.append("#endif")
    w.append("")
    w.append("#include <pnut/loop.h>")
    w.append("#include <pnut/topic.h>")
    w.append("")
    w.append(f'#include "{path}.pb.h"')
    w.append("")
    for t in topics:
        p = t.prefix
        lines = [f"{t.name}: {t.full}, {t.depth} deep"]
        lines += t.doc.splitlines() if t.doc else []
        if len(lines) == 1:
            w.append(f"/* {lines[0]} */")
        else:
            w.append(f"/* {lines[0]}")
            w += [f" * {line}".rstrip() for line in lines[1:]]
            w.append(" */")
        w.append("")
        w.append(f"#ifndef {t.msg.size}")
        w.append(f'#  error "{t.full} has no largest size: a topic\'s '
                 'messages are fixed-size structs (RFC 0005)"')
        w.append("#endif")
        w.append("")
        w.append(f"extern const struct pnut_topic_s g_{p}_topic;")
        w.append("")
        w.append("/* A reader: a program keeps one for each subscription. "
                 "A message is")
        w.append(" * valid while its handler runs.")
        w.append(" */")
        w.append("")
        w.append(f"struct {p}_reader_s;")
        w.append("")
        w.append(f"typedef CODE void (*{p}_handler_t)"
                 f"(FAR struct {p}_reader_s *reader,")
        w.append(f"    FAR const {t.msg.type} *msg, FAR void *arg);")
        w.append("")
        w.append(f"struct {p}_reader_s")
        w.append("{")
        w.append("  /* The library's */")
        w.append("")
        w.append("  FAR struct pnut_subscriber_s *sub;")
        w.append(f"  {p}_handler_t handler;")
        w.append("  FAR void *arg;")
        w.append("};")
        w.append("")
    w.append("#ifdef __cplusplus")
    w.append('extern "C"')
    w.append("{")
    w.append("#endif")
    w.append("")
    for t in topics:
        p = t.prefix
        w.append(f"int {p}_advertise(FAR struct pnut_loop_s *loop,")
        w.append("    FAR struct pnut_publisher_s **pubp);")
        w.append(f"int {p}_publish(FAR struct pnut_publisher_s *pub,")
        w.append(f"    FAR const {t.msg.type} *msg);")
        w.append(f"int {p}_subscribe(FAR struct pnut_loop_s *loop,")
        w.append(f"    {p}_handler_t handler, FAR void *arg,")
        w.append(f"    FAR struct {p}_reader_s *reader);")
        w.append(f"void {p}_unsubscribe(FAR struct {p}_reader_s *reader);")
        w.append("")
    w.append("#ifdef __cplusplus")
    w.append("}")
    w.append("#endif")
    w.append("")
    w.append(f"#endif /* {guard} */")
    return "\n".join(w) + "\n"


def topics_source(path, topics, fdesc):
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append(f'#include "{path}.topics.h"')
    w.append("")
    w.append("/* On NuttX, uORB's descriptions of the topics, which outlive "
             "every")
    w.append(" * reader: uORB keeps a pointer to them")
    w.append(" */")
    w.append("")
    w.append("#if defined(__NuttX__) && defined(CONFIG_UORB)")
    w.append("#  include <uORB/uORB.h>")
    w.append("")
    for t in topics:
        w.append(f"ORB_DEFINE({t.name}, {t.msg.type}, NULL);")
    w.append("#endif")
    w.append("")
    for t in topics:
        p = t.prefix
        w.append(f"const struct pnut_topic_s g_{p}_topic =")
        w.append("{")
        w.append(f'  "{t.name}", sizeof({t.msg.type}), {t.depth},')
        w.append("#if defined(__NuttX__) && defined(CONFIG_UORB)")
        w.append(f"  ORB_ID({t.name})")
        w.append("#else")
        w.append("  NULL")
        w.append("#endif")
        w.append("};")
        w.append("")
        w.append(f"static void {p}_deliver(FAR struct pnut_subscriber_s "
                 "*sub,")
        w.append("    FAR const void *msg, FAR void *arg)")
        w.append("{")
        w.append(f"  FAR struct {p}_reader_s *reader = arg;")
        w.append("")
        w.append("  (void)sub;")
        w.append("  reader->handler(reader, msg, reader->arg);")
        w.append("}")
        w.append("")
        w.append(f"int {p}_advertise(FAR struct pnut_loop_s *loop,")
        w.append("    FAR struct pnut_publisher_s **pubp)")
        w.append("{")
        w.append(f"  return pnut_topic_advertise(loop, &g_{p}_topic, pubp);")
        w.append("}")
        w.append("")
        w.append(f"int {p}_publish(FAR struct pnut_publisher_s *pub,")
        w.append(f"    FAR const {t.msg.type} *msg)")
        w.append("{")
        w.append("  return pnut_topic_publish(pub, msg);")
        w.append("}")
        w.append("")
        w.append(f"int {p}_subscribe(FAR struct pnut_loop_s *loop,")
        w.append(f"    {p}_handler_t handler, FAR void *arg,")
        w.append(f"    FAR struct {p}_reader_s *reader)")
        w.append("{")
        w.append("  reader->handler = handler;")
        w.append("  reader->arg     = arg;")
        w.append(f"  return pnut_topic_subscribe(loop, &g_{p}_topic, "
                 f"{p}_deliver,")
        w.append("                              reader, &reader->sub);")
        w.append("}")
        w.append("")
        w.append(f"void {p}_unsubscribe(FAR struct {p}_reader_s *reader)")
        w.append("{")
        w.append("  pnut_topic_unsubscribe(reader->sub);")
        w.append("  reader->sub = NULL;")
        w.append("}")
        w.append("")
    return "\n".join(w)


# A settings message's fields, by protobuf type: how a setting is kept in
# the message's struct, and its integers' range

FD = descriptor_pb2.FieldDescriptorProto

INT_KINDS = {
    FD.TYPE_INT32: ("INT32", -2**31, 2**31 - 1),
    FD.TYPE_SINT32: ("INT32", -2**31, 2**31 - 1),
    FD.TYPE_SFIXED32: ("INT32", -2**31, 2**31 - 1),
    FD.TYPE_UINT32: ("UINT32", 0, 2**32 - 1),
    FD.TYPE_FIXED32: ("UINT32", 0, 2**32 - 1),
    FD.TYPE_INT64: ("INT64", -2**63, 2**63 - 1),
    FD.TYPE_SINT64: ("INT64", -2**63, 2**63 - 1),
    FD.TYPE_SFIXED64: ("INT64", -2**63, 2**63 - 1),
}

# pnut.Setting's limits (proto/pnut/settings.proto), without their NULs

SETTING_LIMITS = {"key": 64, "label": 48, "group": 48, "unit": 16,
                  "choice": 31, "choices": 16}

SETTING_NAME = re.compile(r"[a-z0-9_][a-z0-9._]*")
OWNER_NAME = re.compile(r"[a-z0-9_-][a-z0-9._-]*")


def c_string(text):
    """A C string literal."""
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def c_int64(value):
    """An int64_t constant, INT64_MIN included."""
    if value == -2**63:
        return "INT64_MIN"
    return f"INT64_C({value})"


class Setting:
    """A field of a settings message."""

    def __init__(self, owner, fdesc_msg, field):
        where = f"{owner.full}.{field.name}"
        if not field.options.HasExtension(options_pb2.setting):
            raise GenError(f"{where}: no (pnut.setting)")
        if field.label == FD.LABEL_REPEATED:
            raise GenError(f"{where}: a setting is not repeated")
        if field.HasField("oneof_index") or field.proto3_optional:
            raise GenError(f"{where}: a setting is not optional, nor in a "
                           "oneof")
        opts = field.options.Extensions[options_pb2.setting]

        # nanopb's C style names the struct's member, as the index

        self.field = underscore(field.name)
        self.upper = self.field.upper()
        self.key = opts.key if opts.HasField("key") else self.field
        self.label = opts.label
        self.group = opts.group
        self.unit = opts.unit
        self.public = opts.public
        self.choices = list(opts.choices)
        self.has_default = opts.HasField("default")
        self.default = opts.default
        self.min = 0
        self.max = 0
        self.integer = 0

        if not SETTING_NAME.fullmatch(self.key) or \
                len(self.key) > SETTING_LIMITS["key"]:
            raise GenError(f"{where}: key {self.key!r}: lowercase letters, "
                           "digits, dots and underscores, at most 64")
        for name in ("label", "group", "unit"):
            if len(getattr(self, name)) > SETTING_LIMITS[name]:
                raise GenError(f"{where}: {name} longer than "
                               f"{SETTING_LIMITS[name]}")

        if field.type == FD.TYPE_BOOL:
            self.type, self.kind = "BOOLEAN", "BOOL"
            if self.has_default and self.default not in ("true", "false"):
                raise GenError(f"{where}: default {self.default!r}: true "
                               "or false")
            self.integer = 1 if self.default == "true" else 0
        elif field.type in INT_KINDS:
            self.type = "INTEGER"
            self.kind, lo, hi = INT_KINDS[field.type]
            self.min = opts.min if opts.HasField("min") else lo
            self.max = opts.max if opts.HasField("max") else hi
            if not lo <= self.min <= self.max <= hi:
                raise GenError(f"{where}: range {self.min} to {self.max} "
                               "does not fit the field")
            if self.has_default:
                try:
                    self.integer = int(self.default, 10)
                except ValueError:
                    raise GenError(f"{where}: default {self.default!r}: "
                                   "not an integer") from None
            if not self.min <= self.integer <= self.max:
                raise GenError(f"{where}: default {self.integer} out of "
                               "its range" if self.has_default else
                               f"{where}: a range that leaves out 0 needs "
                               "a default")
        elif field.type == FD.TYPE_STRING:
            self.kind = "TEXT"
            if opts.secret:
                # Settings never lists a secret's value, nor sets one yet
                # (RFC 0025), so the cache could neither read nor write it

                raise GenError(f"{where}: secrets come later: the typed "
                               "settings cannot hold one yet")
            elif self.choices:
                self.type = "CHOICE"
                if len(self.choices) > SETTING_LIMITS["choices"]:
                    raise GenError(f"{where}: more than 16 choices")
                for c in self.choices:
                    if not c or len(c) > SETTING_LIMITS["choice"]:
                        raise GenError(f"{where}: choice {c!r}: 1 to 31 "
                                       "characters")
                if len(set(self.choices)) != len(self.choices):
                    raise GenError(f"{where}: a choice given twice")
                if self.has_default and self.default not in self.choices:
                    raise GenError(f"{where}: default {self.default!r} is "
                                   "not a choice")
            else:
                self.type = "STRING"
        else:
            raise GenError(f"{where}: a setting is a bool, an integer or a "
                           "string")

        if self.type != "INTEGER" and (opts.HasField("min") or
                                       opts.HasField("max")):
            raise GenError(f"{where}: a range is an integer's")
        if self.type != "CHOICE" and self.choices:
            raise GenError(f"{where}: choices are a string's")


class Settings:
    """A message whose fields are an owner's settings."""

    def __init__(self, fdesc, desc):
        self.msg = Msg(f".{fdesc.package}.{desc.name}" if fdesc.package
                       else f".{desc.name}")
        self.full = self.msg.proto
        self.owner = desc.options.Extensions[options_pb2.settings]
        self.prefix = c_name(self.full)
        self.upper = self.prefix.upper()
        self.doc = ""

        if not OWNER_NAME.fullmatch(self.owner) or len(self.owner) > 64:
            raise GenError(f"{self.full}: owner {self.owner!r}: lowercase "
                           "letters, digits, dots, dashes and underscores, "
                           "at most 64")
        if desc.options.HasExtension(options_pb2.topic):
            raise GenError(f"{self.full}: settings, or a topic, not both")
        if desc.nested_type or desc.enum_type:
            raise GenError(f"{self.full}: a settings message nests nothing")

        self.settings = [Setting(self, desc, f) for f in desc.field]
        if not self.settings:
            raise GenError(f"{self.full}: no settings")
        if len(self.settings) > 64:
            raise GenError(f"{self.full}: more than 64 settings")
        keys = [s.key for s in self.settings]
        if len(set(keys)) != len(keys):
            raise GenError(f"{self.full}: a key used twice")
        # The index enum is {P}_{FIELD}: it must not be one of nanopb's
        # macros for the message ({P}_SIZE, {P}_{FIELD}_TAG...) nor ours

        taken = {"OWNER", "NSETTINGS", "SIZE", "FIELDS", "INIT_ZERO",
                 "INIT_DEFAULT", "CALLBACK", "DEFAULT", "FIELDLIST"}
        taken |= {s.upper + "_TAG" for s in self.settings}
        for s in self.settings:
            if s.upper in taken:
                raise GenError(f"{self.full}.{s.field}: its index "
                               f"{self.upper}_{s.upper} clashes with "
                               "nanopb's or the generated code's names")


def settings_names(st):
    """The C names a settings message's code takes."""
    p = st.prefix
    names = {f"{p}_open", f"{p}_close", f"{p}_s", f"g_{p}_desc",
             f"g_{p}_decls", f"{st.upper}_OWNER", f"{st.upper}_NSETTINGS"}
    for s in st.settings:
        names |= {f"{p}_set_{s.field}", f"{st.upper}_{s.upper}"}
    return names


def settings_header(path, all_settings, fdesc):
    guard = "__PNUT_GEN_" + re.sub(r"\W", "_", path).upper() + "_SETTINGS_H"
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append(f"#ifndef {guard}")
    w.append(f"#define {guard}")
    w.append("")
    w.append("#ifdef __NuttX__")
    w.append("#  include <nuttx/config.h>")
    w.append("#endif")
    w.append("")
    w.append("#include <stdbool.h>")
    w.append("#include <stdint.h>")
    w.append("")
    w.append("#include <pnut/module.h>")
    w.append("#include <pnut/settings_cache.h>")
    w.append("")
    w.append(f'#include "{path}.pb.h"')
    w.append("")
    for st in all_settings:
        p = st.prefix
        lines = [f"{st.owner}'s settings (RFC 0025), from {st.full}:",
                 f"{st.msg.type} holds their values, which the cache keeps",
                 "(pnut/settings_cache.h)."]
        lines += st.doc.splitlines() if st.doc else []
        w.append(f"/* {lines[0]}")
        w += [f" * {line}".rstrip() for line in lines[1:]]
        w.append(" */")
        w.append("")
        w.append(f"#define {st.upper}_OWNER {c_string(st.owner)}")
        w.append("")
        w.append("/* Each setting's index */")
        w.append("")
        w.append("enum")
        w.append("{")
        for i, s in enumerate(st.settings):
            w.append(f"  {st.upper}_{s.upper} = {i},")
        w.append(f"  {st.upper}_NSETTINGS")
        w.append("};")
        w.append("")
        w.append(f"extern const struct pnut_settings_desc_s g_{p}_desc;")
        w.append("")
        w.append(f"struct {p}_s")
        w.append("{")
        w.append("  /* The values, read on the loop */")
        w.append("")
        w.append(f"  {st.msg.type} values;")
        w.append("")
        w.append("  /* The library's */")
        w.append("")
        w.append("  struct pnut_settings_cache_s cache;")
        w.append("};")
        w.append("")
    w.append("#ifdef __cplusplus")
    w.append('extern "C"')
    w.append("{")
    w.append("#endif")
    w.append("")
    for st in all_settings:
        p = st.prefix
        w.append(f"int {p}_open(FAR struct pnut_module_s *module,")
        w.append("    pnut_settings_changed_t changed, FAR void *arg,")
        w.append(f"    FAR struct {p}_s *settings);")
        w.append(f"void {p}_close(FAR struct {p}_s *settings);")
        for s in st.settings:
            ctype = {"BOOL": "bool", "INT32": "int32_t",
                     "UINT32": "uint32_t", "INT64": "int64_t",
                     "TEXT": "FAR const char *"}[s.kind]
            sep = "" if ctype.endswith("*") else " "
            w.append(f"int {p}_set_{s.field}(FAR struct {p}_s *settings,")
            w.append(f"    {ctype}{sep}value, pnut_settings_done_t done, "
                     "FAR void *arg);")
        w.append("")
    w.append("#ifdef __cplusplus")
    w.append("}")
    w.append("#endif")
    w.append("")
    w.append(f"#endif /* {guard} */")
    return "\n".join(w) + "\n"


def settings_source(path, all_settings, fdesc):
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append("#include <stddef.h>")
    w.append("#include <stdint.h>")
    w.append("#include <string.h>")
    w.append("")
    w.append(f'#include "{path}.settings.h"')
    w.append("")
    for st in all_settings:
        p = st.prefix
        t = st.msg.type
        for s in st.settings:
            if s.kind != "TEXT":
                continue

            # A string field nanopb gave no max_size is a callback, not an
            # array: this fails to compile for it.  A default or a choice
            # longer than the field does too.

            w.append(f"typedef char {p}_{s.field}_is_text"
                     f"[sizeof((({t} *)0)->{s.field}[0]) == 1 ? 1 : -1];")

            # Settings takes 1 to 256 bytes

            w.append(f"typedef char {p}_{s.field}_size"
                     f"[sizeof((({t} *)0)->{s.field}) >= 2 && "
                     f"sizeof((({t} *)0)->{s.field}) <= "
                     "sizeof(((pnut_setting_value_t *)0)->value.text) ? "
                     "1 : -1];")
            for i, text in enumerate(([s.default] if s.has_default else []) +
                                     s.choices):
                w.append(f"typedef char {p}_{s.field}_fits_{i}"
                         f"[sizeof({c_string(text)}) <= "
                         f"sizeof((({t} *)0)->{s.field}) ? 1 : -1];")
            if s.choices:
                w.append("")
                w.append(f"static const char * const g_{p}_{s.field}"
                         "_choices[] =")
                w.append("{")
                w.append("  " + ", ".join(c_string(c) for c in s.choices))
                w.append("};")
            w.append("")
        w.append(f"static const struct pnut_setting_decl_s g_{p}_decls[] =")
        w.append("{")
        for s in st.settings:
            size = f"sizeof((({t} *)0)->{s.field})"
            w.append("  {")
            w.append(f"    .key         = {c_string(s.key)},")
            for name in ("label", "group", "unit"):
                if getattr(s, name):
                    w.append(f"    .{name:<11} = "
                             f"{c_string(getattr(s, name))},")
            if s.choices:
                w.append(f"    .choices     = g_{p}_{s.field}_choices,")
                w.append(f"    .nchoices    = {len(s.choices)},")
            if s.has_default and s.kind == "TEXT":
                w.append(f"    .text        = {c_string(s.default)},")
            if s.integer:
                w.append(f"    .integer     = {c_int64(s.integer)},")
            if s.type == "INTEGER":
                w.append(f"    .min         = {c_int64(s.min)},")
                w.append(f"    .max         = {c_int64(s.max)},")
            if s.type in ("STRING", "SECRET"):
                w.append(f"    .max_length  = {size} - 1,")
            w.append(f"    .offset      = offsetof({t}, {s.field}),")
            w.append(f"    .size        = {size},")
            w.append(f"    .type        = PNUT_SETTING_TYPE_{s.type},")
            w.append(f"    .kind        = PNUT_SETTING_KIND_{s.kind},")
            if s.has_default:
                w.append("    .has_default = true,")
            if s.public:
                w.append("    .is_public   = true,")
            w.append("  },")
        w.append("};")
        w.append("")
        w.append(f"const struct pnut_settings_desc_s g_{p}_desc =")
        w.append("{")
        w.append(f"  {st.upper}_OWNER, g_{p}_decls, {st.upper}_NSETTINGS")
        w.append("};")
        w.append("")
        w.append(f"int {p}_open(FAR struct pnut_module_s *module,")
        w.append("    pnut_settings_changed_t changed, FAR void *arg,")
        w.append(f"    FAR struct {p}_s *settings)")
        w.append("{")
        w.append(f"  return pnut_settings_cache_open(module, &g_{p}_desc,")
        w.append("                                  &settings->values, "
                 "changed, arg,")
        w.append("                                  &settings->cache);")
        w.append("}")
        w.append("")
        w.append(f"void {p}_close(FAR struct {p}_s *settings)")
        w.append("{")
        w.append("  pnut_settings_cache_close(&settings->cache);")
        w.append("}")
        w.append("")
        for s in st.settings:
            ctype = {"BOOL": "bool", "INT32": "int32_t",
                     "UINT32": "uint32_t", "INT64": "int64_t",
                     "TEXT": "FAR const char *"}[s.kind]
            sep = "" if ctype.endswith("*") else " "
            w.append(f"int {p}_set_{s.field}(FAR struct {p}_s *settings,")
            w.append(f"    {ctype}{sep}value, pnut_settings_done_t done, "
                     "FAR void *arg)")
            w.append("{")
            w.append("  pnut_setting_value_t v;")
            w.append("")
            w.append("  memset(&v, 0, sizeof(v));")
            if s.kind == "BOOL":
                w.append("  v.which_value   = PNUT_SETTING_VALUE_BOOLEAN_TAG;")
                w.append("  v.value.boolean = value;")
            elif s.kind == "TEXT":
                w.append("  v.which_value = PNUT_SETTING_VALUE_TEXT_TAG;")
                w.append("  strlcpy(v.value.text, value, "
                         "sizeof(v.value.text));")
            else:
                w.append("  v.which_value   = PNUT_SETTING_VALUE_INTEGER_TAG;")
                w.append("  v.value.integer = value;")
            w.append(f"  return pnut_settings_cache_set(&settings->cache, "
                     f"{st.upper}_{s.upper},")
            w.append("                                 &v, done, arg);")
            w.append("}")
            w.append("")
    return "\n".join(w)


def settings_reference(all_settings):
    """The settings' part of a file's reference."""
    w = []
    for st in all_settings:
        w += [f"## Settings of `{st.owner}`", "",
              f"From `{st.full}`; C prefix `{st.prefix}_`.", ""]
        if st.doc:
            w += [st.doc, ""]
        w += ["| Key | Type | Default | Range or choices | Public |",
              "|---|---|---|---|---|"]
        for s in st.settings:
            if s.type == "INTEGER":
                limits = f"{s.min} to {s.max}" + (f" {s.unit}" if s.unit
                                                   else "")
            elif s.type == "CHOICE":
                limits = ", ".join(f"`{c}`" for c in s.choices)
            else:
                limits = "—"
            if s.has_default:
                default = f"`{s.default}`"
            else:
                default = {"BOOLEAN": "`false`", "INTEGER": "`0`",
                           "CHOICE": f"`{s.choices[0]}`" if s.choices
                           else "—", "STRING": "empty",
                           "SECRET": "—"}[s.type]
            w.append(f"| `{s.key}` | {s.type.lower()} | {default} | "
                     f"{limits} | {'yes' if s.public else 'no'} |")
        w.append("")
    return w


def comments(fdesc):
    """The leading comments of services and methods, by path."""
    out = {}
    for loc in fdesc.source_code_info.location:
        if loc.leading_comments:
            lines = [ln.strip() for ln in loc.leading_comments.splitlines()]
            out[tuple(loc.path)] = "\n".join(lines).strip()
    return out


def header(path, svc, fdesc):
    p, u = svc.prefix, svc.upper
    guard = "__PNUT_GEN_" + re.sub(r"\W", "_", path).upper() + "_PNUT_H"
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append(f"#ifndef {guard}")
    w.append(f"#define {guard}")
    w.append("")
    w.append("#ifdef __NuttX__")
    w.append("#  include <nuttx/config.h>")
    w.append("#endif")
    w.append("")
    w.append("#include <stdbool.h>")
    w.append("#include <stdint.h>")
    w.append("")
    w.append("#include <pnut/client.h>")
    w.append("#include <pnut/loop.h>")
    w.append("#include <pnut/msg.h>")
    w.append("#include <pnut/service.h>")
    w.append("")
    w.append(f'#include "{path}.pb.h"')
    w.append('#include "pnut/error.pb.h"')
    w.append("")
    w.append(f"/* {svc.full}, interface {svc.iface} */")
    w.append("")
    w.append(f"#define {u}_IFACE {svc.iface}")
    for m in svc.methods:
        w.append(f"#define {u}_{m.snake.upper()} {m.number}")
    w.append("")
    # Every message needs bounds, for its largest encoding

    msgs = {}
    for m in svc.methods:
        msgs[m.req.size] = m.req.proto
        msgs[m.reply.size] = m.reply.proto
    for size, proto in msgs.items():
        w.append(f"#ifndef {size}")
        w.append(f'#  error "{proto} has no largest size: bound its '
                 'strings, bytes and lists with (nanopb).max_size and '
                 'max_count (RFC 0023)"')
        w.append("#endif")
    w.append("")

    # The largest request and answer bodies, as the size of a union: linear
    # in the methods, where nested conditionals would double with each.  An
    # answer may be an error's detail instead.

    for kind, attr in (("request", "req"), ("reply", "reply")):
        w.append(f"union {p}_{kind}_max_u")
        w.append("{")
        for i, m in enumerate(svc.methods):
            size = getattr(m, attr).size
            w.append(f"  uint8_t m{i}[{size} > 0 ? {size} : 1];")
        if kind == "reply":
            w.append("  uint8_t error[PNUT_ERROR_SIZE];")
        w.append("};")
        w.append("")
    w.append("/* The largest request and answer bodies, an error's detail "
             "included */")
    w.append("")
    w.append(f"#define {u}_REQUEST_MAX sizeof(union {p}_request_max_u)")
    w.append(f"#define {u}_REPLY_MAX sizeof(union {p}_reply_max_u)")
    w.append("")

    # The server

    w.append("/* The server: a program keeps one for each service of this")
    w.append(" * interface it serves.  A handler's request body is valid "
             "while the")
    w.append(" * handler runs; to answer later, keep a copy of *req, and of "
             "what is")
    w.append(" * needed of the body.  A handler left NULL is not served.  An "
             "error")
    w.append(" * answer may carry a detail, pnut.Error, given with "
             f"{p}_fail();")
    w.append(" * its code is one of the interface's own (RFC 0023), and its "
             "text is cut")
    w.append(" * at a character's start to 63 bytes.  _fail() returns "
             "-EINVAL for")
    w.append(" * PNUT_STATUS_OK, -ENOTCONN once the server is closed, or "
             "what")
    w.append(" * pnut_reply() returns.  The permission a method names is not "
             "checked")
    w.append(" * yet.")
    w.append(" */")
    w.append("")
    w.append(f"struct {p}_server_s;")
    w.append("")
    w.append(f"struct {p}_handlers_s")
    w.append("{")
    for m in svc.methods:
        w.append(f"  CODE void (*{m.snake})(FAR struct {p}_server_s *server,")
        w.append("               FAR const struct pnut_request_s *req,")
        w.append(f"               FAR const {m.req.type} *in, FAR void *arg);")
    w.append("};")
    w.append("")
    w.append(f"struct {p}_server_s")
    w.append("{")
    w.append("  /* The library's */")
    w.append("")
    w.append("  FAR struct pnut_service_s *service;")
    w.append(f"  FAR const struct {p}_handlers_s *handlers;")
    w.append("  FAR void *arg;")
    w.append("  union")
    w.append("  {")
    for m in svc.methods:
        w.append(f"    {m.req.type} {m.snake};")
    w.append("  } in;")
    w.append(f"  uint8_t out[{u}_REPLY_MAX];")
    w.append("};")
    w.append("")

    # The client

    w.append("/* The client: a program keeps one for each connection to a "
             "service")
    w.append(" * of this interface.  An answer's body, out, is valid while "
             "its handler")
    w.append(" * runs, and NULL unless the status is PNUT_STATUS_OK; an "
             "error's detail,")
    w.append(" * err, likewise, and NULL unless the service gave one that "
             "decodes.")
    w.append(" */")
    w.append("")
    w.append(f"struct {p}_client_s;")
    w.append("")
    w.append(f"typedef CODE void (*{p}_state_t)"
             f"(FAR struct {p}_client_s *client,")
    w.append("                                bool connected, "
             "FAR void *arg);")
    for m in svc.methods:
        w.append(f"typedef CODE void (*{p}_{m.snake}_done_t)")
        w.append(f"  (FAR struct {p}_client_s *client, int status,")
        w.append(f"   FAR const {m.reply.type} *out,")
        w.append("   FAR const pnut_error_t *err, FAR void *arg);")
    w.append("")
    w.append(f"struct {p}_call_s")
    w.append("{")
    w.append(f"  FAR struct {p}_client_s *client;")
    w.append("  CODE void (*done)(void);")
    w.append("  FAR void *arg;")
    w.append("  bool used;")
    w.append("};")
    w.append("")
    w.append(f"struct {p}_client_s")
    w.append("{")
    w.append("  /* The library's */")
    w.append("")
    w.append("  FAR struct pnut_client_s *client;")
    w.append(f"  {p}_state_t state;")
    w.append("  FAR void *arg;")
    w.append(f"  struct {p}_call_s calls[PNUT_CLIENT_INFLIGHT];")
    w.append("  union")
    w.append("  {")
    for m in svc.methods:
        w.append(f"    {m.reply.type} {m.snake};")
    w.append("  } in;")
    w.append("  pnut_error_t error;")
    w.append(f"  uint8_t out[{u}_REQUEST_MAX];")
    w.append("};")
    w.append("")

    # Prototypes

    w.append("#ifdef __cplusplus")
    w.append('extern "C"')
    w.append("{")
    w.append("#endif")
    w.append("")
    w.append(f"int {p}_serve(FAR struct pnut_loop_s *loop, "
             "FAR const char *name,")
    w.append(f"    uint8_t conns, FAR const struct {p}_handlers_s "
             "*handlers,")
    w.append(f"    FAR void *arg, FAR struct {p}_server_s *server);")
    w.append(f"void {p}_close(FAR struct {p}_server_s *server);")
    w.append(f"int {p}_fail(FAR struct {p}_server_s *server,")
    w.append("    FAR const struct pnut_request_s *req, int status, "
             "uint32_t code,")
    w.append("    FAR const char *text);")
    for m in svc.methods:
        w.append(f"int {p}_{m.snake}_reply(FAR struct {p}_server_s *server,")
        w.append("    FAR const struct pnut_request_s *req, int status,")
        w.append(f"    FAR const {m.reply.type} *out);")
    w.append("")
    w.append(f"int {p}_connect(FAR struct pnut_loop_s *loop, "
             "FAR const char *name,")
    w.append(f"    {p}_state_t state, FAR void *arg,")
    w.append(f"    FAR struct {p}_client_s *client);")
    w.append(f"void {p}_disconnect(FAR struct {p}_client_s *client);")
    for m in svc.methods:
        w.append(f"int {p}_{m.snake}(FAR struct {p}_client_s *client,")
        w.append(f"    FAR const {m.req.type} *in, uint32_t timeout,")
        w.append(f"    {p}_{m.snake}_done_t done, FAR void *arg);")
    w.append("")
    w.append("#ifdef __cplusplus")
    w.append("}")
    w.append("#endif")
    w.append("")
    w.append(f"#endif /* {guard} */")
    return "\n".join(w) + "\n"


def source(path, svc, fdesc):
    p, u = svc.prefix, svc.upper
    w = []
    w.append(f"/* Generated by tools/protoc-gen-pnut from {fdesc.name}: "
             "do not edit */")
    w.append("")
    w.append("#include <errno.h>")
    w.append("#include <string.h>")
    w.append("")
    w.append("#include <pb_decode.h>")
    w.append("#include <pb_encode.h>")
    w.append("")
    w.append(f'#include "{path}.pnut.h"')
    w.append("")

    # Every body must fit a message

    for m in svc.methods:
        for kind, t in (("request", m.req), ("reply", m.reply)):
            w.append(f"typedef char {p}_{m.snake}_{kind}_fits"
                     f"[{t.size} <= PNUT_MSG_PAYLOAD_MAX ? 1 : -1];")
    w.append("")

    # The server's handlers, decoding the request

    for m in svc.methods:
        w.append(f"static void {p}_{m.snake}_handler"
                 "(FAR struct pnut_service_s *service,")
        w.append("    FAR const struct pnut_request_s *req, "
                 "FAR const uint8_t *payload,")
        w.append("    uint16_t len, FAR void *arg)")
        w.append("{")
        w.append(f"  FAR struct {p}_server_s *server = arg;")
        w.append("  pb_istream_t stream = pb_istream_from_buffer(payload, "
                 "len);")
        w.append("")
        w.append("  (void)service;")
        w.append("")
        w.append(f"  if (server->handlers->{m.snake} == NULL)")
        w.append("    {")
        w.append("      pnut_reply(req, PNUT_STATUS_NOTFOUND, NULL, 0);")
        w.append("      return;")
        w.append("    }")
        w.append("")
        w.append(f"  if (!pb_decode(&stream, {m.req.fields}, "
                 f"&server->in.{m.snake}))")
        w.append("    {")
        w.append("      pnut_reply(req, PNUT_STATUS_INVALID, NULL, 0);")
        w.append("      return;")
        w.append("    }")
        w.append("")
        w.append(f"  server->handlers->{m.snake}(server, req, "
                 f"&server->in.{m.snake},")
        w.append("                     server->arg);")
        w.append("}")
        w.append("")

    w.append(f"static const struct pnut_method_s g_{p}_methods[] =")
    w.append("{")
    for m in svc.methods:
        w.append(f"  {{ {u}_IFACE, {u}_{m.snake.upper()}, {m.version}, "
                 f"{p}_{m.snake}_handler,")
        w.append(f"    {m.reply.size} > PNUT_ERROR_SIZE ? {m.reply.size} : "
                 "PNUT_ERROR_SIZE },")
    w.append("};")
    w.append("")

    # The client's answers, decoding the reply

    for m in svc.methods:
        w.append(f"static void {p}_{m.snake}_answer"
                 "(FAR struct pnut_client_s *c, int status,")
        w.append("    FAR const uint8_t *payload, uint16_t len, "
                 "FAR void *arg)")
        w.append("{")
        w.append(f"  FAR struct {p}_call_s *call = arg;")
        w.append(f"  FAR struct {p}_client_s *client = call->client;")
        w.append(f"  {p}_{m.snake}_done_t done = "
                 f"({p}_{m.snake}_done_t)call->done;")
        w.append("  FAR void *darg = call->arg;")
        w.append(f"  FAR const {m.reply.type} *out = NULL;")
        w.append("  FAR const pnut_error_t *err = NULL;")
        w.append("  pb_istream_t stream;")
        w.append("")
        w.append("  (void)c;")
        w.append("  call->used = false;")
        w.append("")
        w.append("  if (status == PNUT_STATUS_OK)")
        w.append("    {")
        w.append("      stream = pb_istream_from_buffer(payload, len);")
        w.append(f"      if (pb_decode(&stream, {m.reply.fields}, "
                 f"&client->in.{m.snake}))")
        w.append("        {")
        w.append(f"          out = &client->in.{m.snake};")
        w.append("        }")
        w.append("      else")
        w.append("        {")
        w.append("          status = PNUT_STATUS_INVALID;")
        w.append("        }")
        w.append("    }")
        w.append("  else if (len > 0)")
        w.append("    {")
        w.append("      /* An error's detail that does not decode is "
                 "dropped: the status")
        w.append("       * stands")
        w.append("       */")
        w.append("")
        w.append("      stream = pb_istream_from_buffer(payload, len);")
        w.append("      if (pb_decode(&stream, PNUT_ERROR_FIELDS, "
                 "&client->error))")
        w.append("        {")
        w.append("          err = &client->error;")
        w.append("        }")
        w.append("    }")
        w.append("")
        w.append("  done(client, status, out, err, darg);")
        w.append("}")
        w.append("")

    w.append(f"static void {p}_state(FAR struct pnut_client_s *c, "
             "bool connected,")
    w.append("    FAR void *arg)")
    w.append("{")
    w.append(f"  FAR struct {p}_client_s *client = arg;")
    w.append("")
    w.append("  (void)c;")
    w.append("  if (client->state != NULL)")
    w.append("    {")
    w.append("      client->state(client, connected, client->arg);")
    w.append("    }")
    w.append("}")
    w.append("")

    # Public functions: the server

    w.append(f"int {p}_serve(FAR struct pnut_loop_s *loop, "
             "FAR const char *name,")
    w.append(f"    uint8_t conns, FAR const struct {p}_handlers_s "
             "*handlers,")
    w.append(f"    FAR void *arg, FAR struct {p}_server_s *server)")
    w.append("{")
    w.append("  memset(server, 0, sizeof(*server));")
    w.append("  server->handlers = handlers;")
    w.append("  server->arg      = arg;")
    w.append("")
    w.append(f"  return pnut_service_open(loop, name, g_{p}_methods,")
    w.append(f"                           sizeof(g_{p}_methods) /")
    w.append(f"                           sizeof(g_{p}_methods[0]),")
    w.append("                           conns, server, "
             "&server->service);")
    w.append("}")
    w.append("")
    w.append(f"void {p}_close(FAR struct {p}_server_s *server)")
    w.append("{")
    w.append("  pnut_service_close(server->service);")
    w.append("  server->service = NULL;")
    w.append("}")
    w.append("")
    w.append(f"int {p}_fail(FAR struct {p}_server_s *server,")
    w.append("    FAR const struct pnut_request_s *req, int status, "
             "uint32_t code,")
    w.append("    FAR const char *text)")
    w.append("{")
    w.append("  pb_ostream_t stream = pb_ostream_from_buffer"
             "(server->out,")
    w.append("                                               "
             "sizeof(server->out));")
    w.append("  pnut_error_t err = PNUT_ERROR_INIT_ZERO;")
    w.append("  size_t n;")
    w.append("")
    w.append("  if (server->service == NULL)")
    w.append("    {")
    w.append("      return -ENOTCONN;")
    w.append("    }")
    w.append("")
    w.append("  if (status == PNUT_STATUS_OK)")
    w.append("    {")
    w.append("      return -EINVAL;")
    w.append("    }")
    w.append("")
    w.append("  err.code = code;")
    w.append("  if (text != NULL)")
    w.append("    {")
    w.append("      /* A longer text is cut, at a character's start */")
    w.append("")
    w.append("      n = strlen(text);")
    w.append("      if (n >= sizeof(err.text))")
    w.append("        {")
    w.append("          n = sizeof(err.text) - 1;")
    w.append("          while (n > 0 && ((uint8_t)text[n] & 0xc0) == 0x80)")
    w.append("            {")
    w.append("              n--;")
    w.append("            }")
    w.append("        }")
    w.append("")
    w.append("      memcpy(err.text, text, n);")
    w.append("      err.text[n] = '\\0';")
    w.append("    }")
    w.append("")
    w.append("  if (!pb_encode(&stream, PNUT_ERROR_FIELDS, &err))")
    w.append("    {")
    w.append("      return -EINVAL;")
    w.append("    }")
    w.append("")
    w.append("  return pnut_reply(req, status, server->out, "
             "(uint16_t)stream.bytes_written);")
    w.append("}")
    w.append("")
    for m in svc.methods:
        w.append(f"int {p}_{m.snake}_reply(FAR struct {p}_server_s *server,")
        w.append("    FAR const struct pnut_request_s *req, int status,")
        w.append(f"    FAR const {m.reply.type} *out)")
        w.append("{")
        w.append("  pb_ostream_t stream = pb_ostream_from_buffer"
                 "(server->out,")
        w.append("                                               "
                 "sizeof(server->out));")
        w.append("")
        w.append("  /* Closed, the request's connection is gone with it */")
        w.append("")
        w.append("  if (server->service == NULL)")
        w.append("    {")
        w.append("      return -ENOTCONN;")
        w.append("    }")
        w.append("")
        w.append("  /* An error answer here has no body: _fail() gives one "
                 "its detail */")
        w.append("")
        w.append("  if (status == PNUT_STATUS_OK && out != NULL &&")
        w.append(f"      !pb_encode(&stream, {m.reply.fields}, out))")
        w.append("    {")
        w.append("      return -EINVAL;")
        w.append("    }")
        w.append("")
        w.append("  return pnut_reply(req, status, server->out, "
                 "(uint16_t)stream.bytes_written);")
        w.append("}")
        w.append("")

    # Public functions: the client

    w.append(f"int {p}_connect(FAR struct pnut_loop_s *loop, "
             "FAR const char *name,")
    w.append(f"    {p}_state_t state, FAR void *arg,")
    w.append(f"    FAR struct {p}_client_s *client)")
    w.append("{")
    w.append("  int i;")
    w.append("")
    w.append("  memset(client, 0, sizeof(*client));")
    w.append("  client->state = state;")
    w.append("  client->arg   = arg;")
    w.append("  for (i = 0; i < PNUT_CLIENT_INFLIGHT; i++)")
    w.append("    {")
    w.append("      client->calls[i].client = client;")
    w.append("    }")
    w.append("")
    w.append("  return pnut_client_open(loop, name, PNUT_CLIENT_INFLIGHT, "
             "NULL,")
    w.append(f"                          {p}_state, client, "
             "&client->client);")
    w.append("}")
    w.append("")
    w.append(f"void {p}_disconnect(FAR struct {p}_client_s *client)")
    w.append("{")
    w.append("  pnut_client_close(client->client);")
    w.append("  client->client = NULL;")
    w.append("}")
    w.append("")
    for m in svc.methods:
        w.append(f"int {p}_{m.snake}(FAR struct {p}_client_s *client,")
        w.append(f"    FAR const {m.req.type} *in, uint32_t timeout,")
        w.append(f"    {p}_{m.snake}_done_t done, FAR void *arg)")
        w.append("{")
        w.append(f"  FAR struct {p}_call_s *call = NULL;")
        w.append("  pb_ostream_t stream;")
        w.append("  int ret;")
        w.append("  int i;")
        w.append("")
        w.append("  if (client->client == NULL || done == NULL)")
        w.append("    {")
        w.append("      return client->client == NULL ? -ENOTCONN : "
                 "-EINVAL;")
        w.append("    }")
        w.append("")
        w.append("  for (i = 0; i < PNUT_CLIENT_INFLIGHT && call == NULL; "
                 "i++)")
        w.append("    {")
        w.append("      if (!client->calls[i].used)")
        w.append("        {")
        w.append("          call = &client->calls[i];")
        w.append("        }")
        w.append("    }")
        w.append("")
        w.append("  if (call == NULL)")
        w.append("    {")
        w.append("      return -EBUSY;")
        w.append("    }")
        w.append("")
        w.append("  stream = pb_ostream_from_buffer(client->out, "
                 "sizeof(client->out));")
        w.append(f"  if (!pb_encode(&stream, {m.req.fields}, in))")
        w.append("    {")
        w.append("      return -EINVAL;")
        w.append("    }")
        w.append("")
        w.append("  call->done = (CODE void (*)(void))done;")
        w.append("  call->arg  = arg;")
        w.append("  call->used = true;")
        w.append("")
        w.append(f"  ret = pnut_call(client->client, {u}_IFACE, "
                 f"{u}_{m.snake.upper()}, {m.version},")
        w.append("                  client->out, "
                 "(uint16_t)stream.bytes_written, timeout,")
        w.append(f"                  {p}_{m.snake}_answer, call);")
        w.append("  if (ret < 0)")
        w.append("    {")
        w.append("      call->used = false;")
        w.append("    }")
        w.append("")
        w.append("  return ret;")
        w.append("}")
        w.append("")
    return "\n".join(w)


def topics_reference(fdesc, topics):
    """The reference of a file with topics and no interface."""
    w = [f"# {fdesc.package or fdesc.name}: topics", "",
         f"From `{fdesc.name}`.", "",
         "| Topic | Message | Depth |", "|---|---|---|"]
    for t in topics:
        w.append(f"| `{t.name}` | `{t.full}` | {t.depth} |")
    w.append("")
    for t in topics:
        if t.doc:
            w += [f"## {t.name}", "", t.doc, ""]
    return "\n".join(w)


def reference(svc, fdesc, topics):
    w = [f"# {svc.full}", ""]
    if svc.doc:
        w += [svc.doc, ""]
    w += [f"Interface **{svc.iface}**, from `{fdesc.name}`; C prefix "
          f"`{svc.prefix}_`.", ""]
    w += ["| Method | Number | Version | Request | Answer | Permission |",
          "|---|---|---|---|---|---|"]
    for m in svc.methods:
        w.append(f"| `{m.name}` | {m.number} | {m.version} | "
                 f"`{m.req.proto}` | `{m.reply.proto}` | "
                 f"{m.permission or '—'} |")
    w.append("")
    w += ["An error answer may carry `pnut.Error`, whose code is one of the "
          "interface's own (RFC 0023).", ""]
    for m in svc.methods:
        if m.doc:
            w += [f"## {m.name}", "", m.doc, ""]
    if topics:
        w += ["## Topics", "",
              "| Topic | Message | Depth |", "|---|---|---|"]
        for t in topics:
            w.append(f"| `{t.name}` | `{t.full}` | {t.depth} |")
        w.append("")
        for t in topics:
            if t.doc:
                w += [f"### {t.name}", "", t.doc, ""]
    return "\n".join(w)


def generate(request):
    response = plugin_pb2.CodeGeneratorResponse()

    # proto3's optional fields are fine here, as for nanopb

    if hasattr(plugin_pb2.CodeGeneratorResponse, "FEATURE_PROTO3_OPTIONAL"):
        response.supported_features = \
            plugin_pb2.CodeGeneratorResponse.FEATURE_PROTO3_OPTIONAL
    files = {f.name: f for f in request.proto_file}
    ifaces = {}
    names = {}
    owners = {}

    for name in request.file_to_generate:
        fdesc = files[name]
        notes = comments(fdesc)
        path = name[:-len(".proto")] if name.endswith(".proto") else name

        if len(fdesc.service) > 1:
            raise GenError(f"{name}: one interface to a file")

        # Topics: top-level messages with (pnut.topic), each name once in
        # the whole system

        topics = []
        for mi, mdesc in enumerate(fdesc.message_type):
            nested = nested_topics(mdesc)
            if nested:
                raise GenError(f"{fdesc.package}.{mdesc.name}: {nested[0]}: "
                               "a topic's message is a top-level one")
            if mdesc.options.HasExtension(options_pb2.topic):
                t = Topic(fdesc, mdesc)
                t.doc = notes.get((4, mi), "")
                if t.name in names:
                    raise GenError(f"{t.full}: topic {t.name} is "
                                   f"{names[t.name]}'s too")
                names[t.name] = t.full
                topics.append(t)

        # Settings: top-level messages with (pnut.settings), each owner
        # once in the whole system

        settings = []
        for mi, mdesc in enumerate(fdesc.message_type):
            for n in mdesc.nested_type:
                if n.options.HasExtension(options_pb2.settings):
                    raise GenError(f"{fdesc.package}.{mdesc.name}.{n.name}: "
                                   "a settings message is a top-level one")
            if mdesc.options.HasExtension(options_pb2.settings):
                st = Settings(fdesc, mdesc)
                st.doc = notes.get((4, mi), "")
                if st.owner in owners:
                    raise GenError(f"{st.full}: owner {st.owner} is "
                                   f"{owners[st.owner]}'s too")
                owners[st.owner] = st.full
                for t in topics:
                    if settings_names(st) & topic_names(t):
                        raise GenError(f"{st.full}: its code's names clash "
                                       f"with topic {t.name}'s")
                settings.append(st)

        if settings:
            for suffix, text in ((".settings.h",
                                  settings_header(path, settings, fdesc)),
                                 (".settings.c",
                                  settings_source(path, settings, fdesc))):
                out = response.file.add()
                out.name = path + suffix
                out.content = text

        if topics:
            outputs = [(".topics.h", topics_header(path, topics, fdesc)),
                       (".topics.c", topics_source(path, topics, fdesc))]
            if not fdesc.service:
                outputs.append((".md", topics_reference(fdesc, topics) +
                                "\n".join([""] +
                                           settings_reference(settings))))
            for suffix, text in outputs:
                out = response.file.add()
                out.name = path + suffix
                out.content = text
        elif settings and not fdesc.service:
            out = response.file.add()
            out.name = path + ".md"
            out.content = "\n".join([f"# {fdesc.package or fdesc.name}: "
                                     "settings", "",
                                     f"From `{fdesc.name}`.", ""] +
                                    settings_reference(settings))

        for si, sdesc in enumerate(fdesc.service):
            svc = Service(fdesc, sdesc)
            svc.doc = notes.get((6, si), "")
            for mi, m in enumerate(svc.methods):
                m.doc = notes.get((6, si, 2, mi), "")

            for t in topics:
                clash = service_names(svc) & topic_names(t)
                if clash:
                    raise GenError(f"{t.full}: its code's names clash with "
                                   f"{svc.full}'s: {sorted(clash)[0]}")
            for st in settings:
                clash = service_names(svc) & settings_names(st)
                if clash:
                    raise GenError(f"{st.full}: its code's names clash with "
                                   f"{svc.full}'s: {sorted(clash)[0]}")

            if svc.iface in ifaces:
                raise GenError(f"{svc.full}: interface {svc.iface} is "
                               f"{ifaces[svc.iface]}'s too")
            ifaces[svc.iface] = svc.full

            for suffix, text in ((".pnut.h", header(path, svc, fdesc)),
                                 (".pnut.c", source(path, svc, fdesc)),
                                 (".md", reference(svc, fdesc, topics) +
                                  "\n".join([""] +
                                             settings_reference(settings)))):
                out = response.file.add()
                out.name = path + suffix
                out.content = text

    return response


def main():
    request = plugin_pb2.CodeGeneratorRequest.FromString(
        sys.stdin.buffer.read())
    try:
        response = generate(request)
    except GenError as e:
        response = plugin_pb2.CodeGeneratorResponse()
        response.error = str(e)
    sys.stdout.buffer.write(response.SerializeToString())


if __name__ == "__main__":
    main()
