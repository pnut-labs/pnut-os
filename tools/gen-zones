"""The time zones' table, from the tz database (RFC 0028).

    tools/gen-zones [zoneinfo] > src/lib/tz_zones.c

zoneinfo is the compiled tz database, /usr/share/zoneinfo by default.
Every zone of its zone.tab (the zones by country, about 420) and UTC go
into the table, each with its current rule: the POSIX TZ string that ends
each compiled zone file (RFC 8536).  The rules, fewer than 100, are kept
once each.  Past rules are not kept.

The table is kept in the source, so that every build has the same rules;
run this again to update them, from a tz database as new as can be had.
"""

import os
import sys


RULE_CHARS = set(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                 b"0123456789<>+-:,./")


def footer(path):
    """A compiled zone's current rule: the text between its last two
    newlines."""
    with open(path, "rb") as f:
        data = f.read()
    if not data.startswith(b"TZif"):
        sys.exit(f"{path}: not a compiled zone")
    if data[4:5] == b"\0":
        sys.exit(f"{path}: no rule at its end (version 1)")
    if not data.endswith(b"\n"):
        sys.exit(f"{path}: no newline at its end")
    body = data[:-1]
    rule = body[body.rfind(b"\n") + 1:]
    if not rule or not set(rule) <= RULE_CHARS:
        sys.exit(f"{path}: no rule at its end")
    return rule.decode("ascii")


def c_string(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main(argv):
    root = argv[1] if len(argv) > 1 else "/usr/share/zoneinfo"
    version = "unknown"
    try:
        with open(os.path.join(root, "tzdata.zi")) as f:
            first = f.readline().split()
            if first[:2] == ["#", "version"]:
                version = first[2]
    except OSError:
        pass

    names = {"UTC"}
    with open(os.path.join(root, "zone.tab")) as f:
        for line in f:
            if line.startswith("#") or not line.strip():
                continue
            names.add(line.rstrip("\n").split("\t")[2])

    zones = sorted((name, footer(os.path.join(root, name)))
                   for name in names)
    rules = sorted({rule for _, rule in zones})
    index = {rule: i for i, rule in enumerate(rules)}
    if len(rules) > 255:
        sys.exit("more than 255 rules: struct pnut_tz_zone_s's rule is a "
                 "uint8_t")

    banner = "/" + "*" * 76
    end = " " + "*" * 76 + "/"

    def section(title):
        w.extend([banner, f" * {title}", end, ""])

    w = []
    w.append(banner)
    w.append(" * pnut-os/src/lib/tz_zones.c")
    w.append(" *")
    w.append(" * SPDX-License-Identifier: Apache-2.0")
    w.append(" * Copyright 2026 Mateusz Pianka")
    w.append(" *")
    w.append(f" * Generated by tools/gen-zones from the tz database {version}:")
    w.append(" * do not edit.")
    w.append(" *")
    w.append(end)
    w.append("")
    section("Included Files")
    w.append('#include "pnut_tz.h"')
    w.append("")
    section("Public Data")
    w.append(f"/* The current rules, {len(rules)} of them */")
    w.append("")
    w.append("const char * const g_pnut_tz_rules[] =")
    w.append("{")
    for rule in rules:
        w.append(f"  {c_string(rule)},")
    w.append("};")
    w.append("")
    w.append(f"/* The zones, {len(zones)} of them, in the order of their "
             "names */")
    w.append("")
    w.append("const struct pnut_tz_zone_s g_pnut_tz_zones[] =")
    w.append("{")
    for name, rule in zones:
        w.append(f"  {{ {c_string(name)}, {index[rule]} }},")
    w.append("};")
    w.append("")
    w.append(f"const size_t g_pnut_tz_nzones = {len(zones)};")
    w.append("")

    # nxstyle checks a file only when it has one of these sections

    section("Public Functions")
    sys.stdout.write("\n".join(w).rstrip("\n") + "\n")


if __name__ == "__main__":
    main(sys.argv)
